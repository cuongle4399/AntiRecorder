<Window x:Class="WindowsSecureBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AntiRecorder - Trình Duyệt Bảo Mật Riêng Tư" Height="470" Width="600"
        MinWidth="320" MinHeight="220"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Foreground="#F8FAFC"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        StateChanged="Window_StateChanged"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style TargetType="TextBox" x:Key="UrlBoxStyle">
            <Setter Property="Background" Value="#0B0F19"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#A01E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                              Focusable="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F00F172A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterWindowBorder" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="8" SnapsToDevicePixels="True">
        <Grid x:Name="RootGrid" Background="#0B0F19">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Chrome Tab Bar -->
            <RowDefinition Height="Auto"/> <!-- Address Bar & Tools -->
            <RowDefinition Height="*"/>    <!-- WebView Host / Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Chrome-Style Tab Bar Header -->
        <Border x:Name="TabBarHeader" Grid.Row="0" Background="#060A12" Padding="6,4,6,0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" MouseDown="Window_MouseDown">
            <Grid x:Name="TabBarGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>    <!-- Left-aligned Tab Strip + (+) Button -->
                    <ColumnDefinition Width="Auto"/> <!-- Window Controls (— ☐ ✕) -->
                </Grid.ColumnDefinitions>

                <!-- Left-side: Tabs + New Tab (+) Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ScrollViewer x:Name="TabScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" VerticalAlignment="Bottom">
                        <StackPanel x:Name="TabContainer" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <!-- Dynamic Chrome Tabs rendered programmatically -->
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Plus (+) New Tab Button ALWAYS sits immediately after the last tab -->
                    <Button x:Name="btnNewTab" Content="+" Width="28" Height="26" Margin="4,0,8,2"
                            ToolTip="Mở Tab Mới (Ctrl+T)" Click="BtnNewTab_Click"
                            Background="#151D2A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                            FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0"/>
                </StackPanel>

                <!-- Right-side: Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,2,0" VerticalAlignment="Center">
                    <Button Content="—" Click="BtnMinimize_Click" Width="28" Height="24" Margin="0,0,3,0" Padding="0" FontSize="10" ToolTip="Thu nhỏ (Minimize)"/>
                    <Button Content="☐" Click="BtnMaximize_Click" Width="28" Height="24" Margin="0,0,3,0" Padding="0" FontSize="11" ToolTip="Phóng to / Phục hồi (Maximize)"/>
                    <Button Content="✕" Click="BtnCloseWindow_Click" Width="28" Height="24" Padding="0" FontSize="11" Background="#DC2626" Foreground="#FFFFFF" BorderBrush="#EF4444" ToolTip="Thoát ứng dụng (Close)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Address & Navigation Toolbar with Monochrome Vector Icons -->
        <Border x:Name="AddressBarToolbar" Grid.Row="1" Background="#0F172A" Padding="6,4,6,4" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Nav Controls -->
                    <ColumnDefinition Width="*"/>    <!-- URL Box -->
                    <ColumnDefinition Width="Auto"/> <!-- Compact Action Tools -->
                </Grid.ColumnDefinitions>

                <!-- Nav Controls (Crisp Segoe MDL2 Vector Icons) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE72B;" Click="BtnBack_Click" ToolTip="Quay lại (Back)" Width="32" Height="32" Margin="0,0,3,0" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button x:Name="btnForward" Content="&#xE72A;" Click="BtnForward_Click" ToolTip="Tiến tới (Forward)" Width="32" Height="32" Margin="0,0,3,0" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Content="&#xE72C;" Click="BtnRefresh_Click" ToolTip="Tải lại trang (Refresh)" Width="32" Height="32" Margin="0,0,3,0" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button x:Name="btnHome" Content="&#xE80F;" Click="BtnHome_Click" ToolTip="Trang chủ Google (Home)" Width="32" Height="32" Margin="0,0,6,0" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- URL Address Box -->
                <TextBox x:Name="txtAddressBar" Grid.Column="1" Style="{StaticResource UrlBoxStyle}"
                         KeyDown="TxtAddressBar_KeyDown" Text="https://www.google.com"/>

                <!-- Action Tools (Drag Handle & Menu Button) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                    <!-- Drag Move Handle Control -->
                    <Border x:Name="btnDragWindow" PreviewMouseLeftButtonDown="BtnDragWindow_PreviewMouseLeftButtonDown"
                            ToolTip="Nhấp và giữ chuột trái để kéo di chuyển ứng dụng (Drag Window)"
                            Background="#151D2A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4"
                            Width="32" Height="30" Margin="0,0,3,0" Cursor="Arrow">
                        <TextBlock Text="✥" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Menu Button -->
                    <Button x:Name="btnOverflowMenu" Content="☰" Click="BtnOverflowMenu_Click" ToolTip="Menu Chức Năng" Width="32" Height="30" Padding="0" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. WebView Content Container -->
        <Grid Grid.Row="2" x:Name="WebViewHostGrid">
            <!-- Active WebView2 instance will be docked here -->
        </Grid>

        <!-- 3.5 Responsive Overflow Menu Modal / Dropdown Popup -->
        <Border Grid.Row="2" x:Name="OverflowMenuModal" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" MaxWidth="260" MaxHeight="380"
                BorderThickness="1" CornerRadius="8" Padding="10" Canvas.ZIndex="105">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="☰ Menu Chức Năng" FontSize="13" FontWeight="Bold" Margin="4,2,4,8"/>
                    <Button Content="👤 Profile Google" Click="BtnGoogleAccountFromOverflow_Click" Margin="0,0,0,6" Padding="10,6" HorizontalContentAlignment="Left" FontWeight="Bold"/>
                    <Button Content="🧩 Quản lý Extension" Click="BtnExtensionStoreFromOverflow_Click" Margin="0,0,0,6" Padding="10,6" HorizontalContentAlignment="Left" FontWeight="Bold"/>
                    <Button Content="🌐 Cấu hình Proxy" Click="BtnProxyFromOverflow_Click" Margin="0,0,0,6" Padding="10,6" HorizontalContentAlignment="Left" FontWeight="Bold"/>
                    <Button Content="★ Trang yêu thích" Click="BtnBookmarkFromOverflow_Click" Margin="0,0,0,6" Padding="10,6" HorizontalContentAlignment="Left"/>
                    <Button Content="📷 Chụp màn hình" Click="BtnScreenshotFromOverflow_Click" Margin="0,0,0,6" Padding="10,6" HorizontalContentAlignment="Left"/>
                    <Button Content="⬇ Tải xuống" Click="BtnDownloadsFromOverflow_Click" Margin="0,0,0,6" Padding="10,6" HorizontalContentAlignment="Left"/>
                    <Button Content="⚙ Cài đặt &amp; Trong suốt" Click="BtnSettingsFromOverflow_Click" Margin="0,0,0,6" Padding="10,6" HorizontalContentAlignment="Left"/>
                    <Button Content="📖 Hướng dẫn &amp; Phím tắt" Click="BtnHelpFromOverflow_Click" Padding="10,6" HorizontalContentAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 4. Screenshot Options Modal -->
        <Border Grid.Row="2" x:Name="ScreenshotModal" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Margin="8"
                BorderThickness="1" CornerRadius="10" Padding="12" Canvas.ZIndex="98">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button Content="✕" DockPanel.Dock="Right" Click="BtnCloseScreenshotModal_Click" Width="22" Height="22" Padding="0" FontSize="11" ToolTip="Đóng"/>
                    <TextBlock Text="📷 Chụp Ảnh Màn Hình" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>

                <UniformGrid Columns="2">
                    <Button Click="BtnCropScreenshot_Click" Margin="0,0,3,0" Padding="8,10" MinHeight="40">
                        <TextBlock Text="✂ Chụp Cắt Vùng" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    </Button>

                    <Button Click="BtnFullScreenScreenshot_Click" Margin="3,0,0,0" Padding="8,10" MinHeight="40">
                        <TextBlock Text="🖥 Chụp Toàn Màn" FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- 5. Bookmarks Manager Modal -->
        <Border Grid.Row="2" x:Name="BookmarksModal" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" Margin="6"
                BorderThickness="1" CornerRadius="8" Padding="12" Canvas.ZIndex="99">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button Content="✕" DockPanel.Dock="Right" Click="BtnCloseBookmarksModal_Click" Width="22" Height="22" Padding="0" FontSize="11" ToolTip="Đóng"/>
                    <TextBlock Text="★ Trang Yêu Thích" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>

                <Button Content="+ Lưu Trang Hiện Tại" Click="BtnAddCurrentBookmark_Click"
                        FontSize="11" FontWeight="Bold" Padding="8,4" Margin="0,0,0,8" BorderThickness="1"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220">
                    <StackPanel x:Name="BookmarksListContainer">
                        <!-- Dynamic Bookmarks list -->
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 6. Google Account & Profile Manager Modal -->
        <Border Grid.Row="2" x:Name="GoogleAccountModal" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" Margin="6"
                BorderThickness="1" CornerRadius="8" Padding="12" Canvas.ZIndex="100">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button Content="✕" DockPanel.Dock="Right" Click="BtnCloseGoogleAccountModal_Click" Width="22" Height="22" Padding="0" FontSize="11" ToolTip="Đóng"/>
                    <TextBlock Text="👤 Tài Khoản Google &amp; Profile" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>

                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Button Content="Google" Click="BtnGoogleSignIn_Click" Margin="0,0,2,0" Padding="4,4" FontSize="11"/>
                    <Button Content="ChatGPT" Click="BtnOpenChatGPT_Click" Margin="2,0,2,0" Padding="4,4" FontSize="11"/>
                    <Button Content="Gemini" Click="BtnOpenGemini_Click" Margin="2,0,0,0" Padding="4,4" FontSize="11"/>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <Button Content="Profile Cá Nhân" Click="BtnPersonalProfile_Click" Margin="0,0,2,0" Padding="4,4" FontSize="11"/>
                    <Button Content="Profile Khách" Click="BtnGuestProfile_Click" Margin="2,0,0,0" Padding="4,4" FontSize="11"/>
                </UniformGrid>

                <Button Content="🗑 Xóa Cookie &amp; Cache Google" Click="BtnClearGoogleCache_Click" FontSize="11" Padding="8,4"/>
            </StackPanel>
        </Border>

        <!-- 7. Downloads List Modal -->
        <Border Grid.Row="2" x:Name="DownloadsModal" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" Margin="6"
                BorderThickness="1" CornerRadius="8" Padding="12" Canvas.ZIndex="101">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button Content="✕" DockPanel.Dock="Right" Click="BtnCloseDownloadsModal_Click" Width="22" Height="22" Padding="0" FontSize="11" ToolTip="Đóng"/>
                    <TextBlock Text="⬇ Danh Sách Tải Xuống" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>

                <Button Content="📁 Mở Thư Mục Downloads" Click="BtnOpenDownloadsFolder_Click"
                        FontSize="11" FontWeight="Bold" Padding="8,4" Margin="0,0,0,8" BorderThickness="1"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220">
                    <StackPanel x:Name="DownloadsListContainer">
                        <!-- Dynamic Download items -->
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 7.5 Proxy Configuration Modal -->
        <Border Grid.Row="2" x:Name="ProxyModal" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" Margin="6"
                BorderThickness="1" CornerRadius="8" Padding="12" Canvas.ZIndex="101">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button Content="✕" DockPanel.Dock="Right" Click="BtnCloseProxyModal_Click" Width="22" Height="22" Padding="0" FontSize="11" ToolTip="Đóng"/>
                    <TextBlock Text="🌐 Cấu Hình Proxy Tab" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Text="Cấu hình Proxy cho Tab hiện tại:" FontSize="11" Margin="0,0,0,3"/>
                <TextBlock Text="Định dạng: ip:port hoặc ip:port:user:pass" FontSize="10" Opacity="0.75" Margin="0,0,0,6"/>

                <TextBox x:Name="txtProxyInput" Padding="6,4" FontSize="11" Margin="0,0,0,8"
                         ToolTip="Ví dụ: 103.152.118.42:8080 hoặc 103.152.118.42:8080:myuser:mypass"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Button Content="🌐 Áp Dụng" Click="BtnApplyProxy_Click" Margin="0,0,2,0" Padding="4,4" FontSize="11" FontWeight="Bold"/>
                    <Button Content="⚡ Test Ping" Click="BtnPingProxy_Click" Margin="2,0,2,0" Padding="4,4" FontSize="11"/>
                    <Button Content="❌ Tắt Proxy" Click="BtnClearProxy_Click" Margin="2,0,0,0" Padding="4,4" FontSize="11"/>
                </UniformGrid>

                <TextBlock x:Name="txtProxyStatus" Text="" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 7.8 Chrome Extension Management Modal -->
        <Border Grid.Row="2" x:Name="ExtensionsModal" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" Margin="6"
                BorderThickness="1" CornerRadius="8" Padding="12" Canvas.ZIndex="101">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button Content="✕" DockPanel.Dock="Right" Click="BtnCloseExtensionsModal_Click" Width="22" Height="22" Padding="0" FontSize="11" ToolTip="Đóng"/>
                    <TextBlock Text="🧩 Quản Lý Tiện Ích (Extensions)" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <Button Content="📂 Thư Mục Extensions" Click="BtnOpenExtensionsFolder_Click" Padding="6,4" FontSize="11" FontWeight="Bold"/>
                    <Button Content="🛍️ Chrome Web Store" Click="BtnOpenChromeStore_Click" Padding="6,4" FontSize="11"/>
                </UniformGrid>

                <TextBlock Text="Extension Đã Nạp Khi Khởi Động App:" FontSize="11" FontWeight="Bold" Margin="0,2,0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="200">
                    <StackPanel x:Name="ExtensionsListContainer">
                        <!-- Dynamic Extension items -->
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 8. User Guide & Help Modal -->
        <Border Grid.Row="2" x:Name="HelpModal" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" Margin="6"
                BorderThickness="1" CornerRadius="10" Padding="12" Canvas.ZIndex="102">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button Content="✕" DockPanel.Dock="Right" Click="BtnCloseHelpModal_Click" Width="22" Height="22" Padding="0" FontSize="11" ToolTip="Đóng"/>
                    <TextBlock Text="📖 Phím Tắt &amp; Hướng Dẫn" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>

                <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,6" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="F4" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Ẩn / Hiện ứng dụng" FontSize="11" Margin="0,0,0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+Shift+Space" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Mở từ khay hệ thống" FontSize="11" Margin="0,0,0,3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Shift+S" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Menu Chụp ảnh màn hình" FontSize="11" Margin="0,0,0,3"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+T / W / Tab" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Tạo / Đóng / Chuyển Tab" FontSize="11"/>
                    </Grid>
                </Border>

                <Border CornerRadius="6" Padding="8,4" BorderThickness="1">
                    <TextBlock Text="🛡 Anti-Recorder | RAM Snapshot | Audio Muted" FontSize="10" HorizontalAlignment="Center" Opacity="0.85"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 9. In-App Stealth Notification Overlay Modal -->
        <Border Grid.Row="2" x:Name="NotificationModal" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" Margin="6"
                BorderThickness="1" CornerRadius="8" Padding="12" Canvas.ZIndex="103">
            <StackPanel>
                <TextBlock x:Name="txtNotificationTitle" Text="Thông báo" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock x:Name="txtNotificationMessage" Text="Nội dung thông báo..." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Grid x:Name="NotificationButtonsGrid">
                    <Button x:Name="btnNotificationOk" Content="Đồng ý" Click="BtnNotificationOk_Click"
                            FontSize="11" FontWeight="Bold" Padding="12,4" HorizontalAlignment="Right"/>
                    <StackPanel x:Name="NotificationConfirmButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button Content="Hủy" Click="BtnNotificationCancel_Click" FontSize="11" Padding="10,4" Margin="0,0,6,0"/>
                        <Button Content="Xác nhận" Click="BtnNotificationConfirm_Click" FontSize="11" FontWeight="Bold" Padding="10,4"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 9. App Settings & Opacity Configuration Modal -->
        <Border Grid.Row="2" x:Name="SettingsModal" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" MaxHeight="380" Margin="8"
                BorderThickness="1" CornerRadius="10" Padding="14" Canvas.ZIndex="102">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Modal Header -->
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="✕" DockPanel.Dock="Right" Click="BtnCloseSettingsModal_Click" Width="22" Height="22" Padding="0" FontSize="11" ToolTip="Đóng"/>
                        <TextBlock Text="⚙ Cài Đặt Ứng Dụng" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 1. Size App (Default: 600 x 470) -->
                    <Border BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📐 Size:" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="txtStartupWidth" Grid.Column="1" Text="600" Padding="4,2" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Grid.Column="2" Text="x" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="txtStartupHeight" Grid.Column="3" Text="470" Padding="4,2" FontSize="12" Margin="0,0,6,0"/>
                            <Button Grid.Column="4" Content="Lấy Size" Click="BtnPresetCurrentSize_Click" Padding="6,2" FontSize="11" ToolTip="Lấy kích thước cửa sổ hiện tại"/>
                        </Grid>
                    </Border>

                    <!-- 2. Web Zoom Scale -->
                    <Border BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock x:Name="txtZoomPercent" Text="75%" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="🔍 Scale Web:" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="sldZoom" Minimum="0.01" Maximum="3.0" Value="0.75"
                                    SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="False"
                                    ValueChanged="SldZoom_ValueChanged" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- 3. Transparency Opacity -->
                    <Border BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock x:Name="txtOpacityPercent" Text="100%" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="👁️ Trong Suốt:" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="sldOpacity" Minimum="0.2" Maximum="1.0" Value="1.0"
                                    SmallChange="0.05" LargeChange="0.1" TickFrequency="0.02" IsSnapToTickEnabled="True"
                                    ValueChanged="SldOpacity_ValueChanged" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- 3.5 Audio Mute Toggle (Default Muted = True) -->
                    <Border BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                        <DockPanel>
                            <CheckBox x:Name="chkMuteAudio" Content="🔇 Tắt âm thanh trang web (Mute)"
                                      IsChecked="True" Checked="ChkMuteAudio_Changed" Unchecked="ChkMuteAudio_Changed"
                                      FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- 4. Theme & Security Row -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <RadioButton x:Name="rbDarkTheme" Content="🌙 Tối" IsChecked="True" Checked="RbTheme_Checked" FontSize="11" Margin="0,0,8,0"/>
                                <RadioButton x:Name="rbLightTheme" Content="☀️ Sáng" Checked="RbTheme_Checked" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="1" Click="BtnDoCleanup_Click" Content="🛡 Dọn RAM" Padding="8,4" FontSize="11"/>
                    </Grid>

                    <TextBlock x:Name="txtCleanupStatus" Text="" FontSize="11" Margin="0,2,0,4" HorizontalAlignment="Center" TextWrapping="Wrap"/>

                    <!-- Footer Save Button -->
                    <DockPanel Margin="0,2,0,0">
                        <Button x:Name="btnSaveSettings" Click="BtnSaveSettings_Click" Content="💾 Lưu Cấu Hình"
                                DockPanel.Dock="Right" FontSize="12" FontWeight="Bold" Padding="12,5"/>
                        <TextBlock x:Name="txtSaveSettingsStatus" Text="" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 10. Status Bar -->
        <Border x:Name="StatusBarBorder" Grid.Row="3" Background="#060A12" Padding="12,6" BorderBrush="#151D2A" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="txtStatus" Text="Sẵn sàng (Nhấn F4 để Ẩn/Hiện trình duyệt)" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtProxyBadge" Text="" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Code by CL" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" Margin="0,0,16,0" Opacity="0.85" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtMemoryUsage" Text="RAM: -- MB" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Border>
</Window>
